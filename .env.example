# Copy this file to `.env.local`. Git ignores `.env.local`. Never commit a real key.

# The URL of the Supabase project. The local stack of the arkad repository runs at this URL.
VITE_SUPABASE_URL=http://127.0.0.1:54321
# The publishable key of the Supabase project. For the local stack, `supabase status` prints it.
VITE_SUPABASE_ANON_KEY=<publishable key>
