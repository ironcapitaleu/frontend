{
	"$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
	// Biome 2.6 formats Markdown and YAML. Its Markdown formatter removes the
	// indent from the folded `description: >` front matter in every
	// .claude/skills/*/SKILL.md, which makes it invalid YAML. Biome 2.5 never
	// checked these files, so keep them out.
	"files": {
		"includes": ["**", "!**/*.md", "!**/*.yaml", "!**/*.yml"]
	},

	"formatter": {
		"enabled": true
	},

	"css": {
		"parser": {
			"cssModules": true,
			"tailwindDirectives": true
		}
	},

	"linter": {
		"enabled": true
	},

	"assist": {
		"enabled": false
	},

	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	}
}
